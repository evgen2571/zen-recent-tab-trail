[
  {
    "type": "string",
    "property": "recent-tab-trail.count",
    "label": "Number of recent tabs",
    "defaultValue": "5",
    "placeholder": "1–20"
  },
  {
    "type": "dropdown",
    "property": "recent-tab-trail.workspace",
    "label": "Workspace history",
    "defaultValue": "current",
    "placeholder": false,
    "options": [
      { "label": "Current workspace", "value": "current" },
      { "label": "Global", "value": "global" }
    ]
  },
  {
    "type": "checkbox",
    "property": "recent-tab-trail.include-pinned",
    "label": "Include pinned tabs",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "recent-tab-trail.include-essentials",
    "label": "Include Essentials",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Appearance"
  },
  {
    "type": "dropdown",
    "property": "recent-tab-trail.style",
    "label": "Indicator style",
    "defaultValue": "both",
    "placeholder": false,
    "options": [
      { "label": "Bar + tint", "value": "both" },
      { "label": "Bar only", "value": "bar" },
      { "label": "Outline", "value": "outline" },
      { "label": "Tint", "value": "background" },
      { "label": "Solid fill", "value": "fill" }
    ]
  },
  {
    "type": "dropdown",
    "property": "recent-tab-trail.color-source",
    "label": "Color",
    "defaultValue": "theme",
    "placeholder": false,
    "options": [
      { "label": "Zen accent", "value": "theme" },
      { "label": "Purple", "value": "purple" },
      { "label": "Blue", "value": "blue" },
      { "label": "Cyan", "value": "cyan" },
      { "label": "Green", "value": "green" },
      { "label": "Orange", "value": "orange" },
      { "label": "Red", "value": "red" },
      { "label": "Pink", "value": "pink" },
      { "label": "Custom…", "value": "custom" }
    ]
  },
  {
    "type": "string",
    "property": "recent-tab-trail.custom-color",
    "label": "Custom color",
    "defaultValue": "#7c6cff",
    "placeholder": "#7c6cff",
    "border": "value",
    "conditions": [
      {
        "if": {
          "property": "recent-tab-trail.color-source",
          "value": "custom"
        }
      }
    ]
  },
  {
    "type": "dropdown",
    "property": "recent-tab-trail.strength",
    "label": "Intensity",
    "defaultValue": "normal",
    "placeholder": false,
    "options": [
      { "label": "Subtle", "value": "subtle" },
      { "label": "Normal", "value": "normal" },
      { "label": "Strong", "value": "strong" }
    ]
  }
]
